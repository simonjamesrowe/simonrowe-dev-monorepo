# The software factory runs its webhook API and its Temporal worker in one JVM, so
# this image carries the agent's runtime dependencies too: git, to clone pull-request
# branches, and the Claude Code binary it shells out to.
#
# Claude Code is pinned rather than tracked at :latest. The version moves when this
# ARG moves and not through a background self-update, so a review that passed
# yesterday is reproducible today.
ARG CLAUDE_VERSION=2.1.220

FROM eclipse-temurin:21-jdk AS build

WORKDIR /workspace

COPY gradlew build.gradle.kts settings.gradle.kts ./
COPY gradle/ gradle/
COPY config/checkstyle/ config/checkstyle/
COPY backend/build.gradle.kts backend/build.gradle.kts
COPY software-factory/build.gradle.kts software-factory/build.gradle.kts
COPY software-factory/src/ software-factory/src/

RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :software-factory:bootJar --no-daemon

# Downloaded in a throwaway stage so curl and jq never reach the runtime image.
# Same release endpoint and the same published SHA-256 check the old host installer
# performed; the official install.sh cannot be used here because it refuses to run
# as root and targets the invoking user's ~/.local/bin.
FROM debian:13-slim AS claude

ARG CLAUDE_VERSION
ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl jq \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH}" in \
      arm64) platform=linux-arm64 ;; \
      amd64) platform=linux-x64 ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base=https://downloads.claude.ai/claude-code-releases; \
    checksum="$(curl -fsSL "${base}/${CLAUDE_VERSION}/manifest.json" \
      | jq -r ".platforms[\"${platform}\"].checksum // empty")"; \
    echo "${checksum}" | grep -Eq '^[a-f0-9]{64}$'; \
    curl -fsSL -o /tmp/claude "${base}/${CLAUDE_VERSION}/${platform}/claude"; \
    echo "${checksum}  /tmp/claude" | sha256sum -c -; \
    chmod 0755 /tmp/claude

FROM eclipse-temurin:21-jre

# git clones the pull-request branch the agent reviews.
#
# curl and jq are here for the deploy flow, not the reviewer: the same image runs
# as the `deployer` service, which executes scripts/restart-prod.sh. That script's
# container settle loop parses `docker compose ps --format json` with jq and its
# verification curls the public hostnames. jq was previously installed only in the
# throwaway `claude` stage above, so it never reached the runtime image.
#
# jq deliberately rather than python3: the settle-loop parser used to be an inline
# Python program, and keeping it would mean carrying a whole Python runtime in this
# image for one JSON filter. See specs/036-auto-deploy-on-merge/research.md §3.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git curl jq \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10003 factory \
    && useradd --system --uid 10003 --gid factory --home-dir /app factory

# root-owned 0755: the service user executes it but cannot replace it, so a review
# cannot swap the agent binary underneath the next one.
COPY --from=claude --chown=root:root --chmod=0755 /tmp/claude /usr/local/bin/claude

WORKDIR /app
COPY --from=build --chown=factory:factory \
    /workspace/software-factory/build/libs/software-factory-*.jar /app/software-factory.jar

# Clone target. Compose backs this with a named volume, so pull-request branches
# never land on the host filesystem.
RUN mkdir -p /workspace && chown factory:factory /workspace

USER factory

ENV CLAUDE_COMMAND=/usr/local/bin/claude \
    FACTORY_WORKSPACE_ROOT=/workspace \
    HOME=/app

EXPOSE 8090 8091
ENTRYPOINT ["java", "-jar", "/app/software-factory.jar"]
