# =============================================================================
# Environment Variables
# Copy to .env and fill in values: cp .env.example .env && chmod 0600 .env
# Used by: docker-compose.prod.yml (env_file) and Docker Compose interpolation.
#
# Keep .env at mode 0600. It is the only copy of every production credential,
# including the Claude token used by the software factory.
#
# Not every service sees every variable. Services with `env_file: .env` in
# docker-compose.prod.yml receive the whole file; software-factory deliberately
# does not, and declares only the variables it needs. It terminates untrusted
# internet traffic (the GitHub webhook), so do not add `env_file` to it — that
# would hand every unrelated production secret to that process.
# =============================================================================

# --- Backend Secrets ---

# Brevo SMTP relay password
BREVO_SMTP_PASSWORD=your-brevo-smtp-password

# Google reCAPTCHA v2 secret key (server-side verification)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Groq API key (LLM provider)
GROQ_API_KEY=your-groq-api-key

# Google Gemini API key (Spring AI)
GOOGLE_GENAI_API_KEY=your-google-genai-api-key

# OpenAI API key (Spring AI; also set as the OPENAI_API_KEY GitHub Actions secret for evals.yml)
OPENAI_API_KEY=your-openai-api-key

# --- Software Factory (code review) ---
# One container runs both the GitHub webhook receiver and the Temporal worker that
# invokes Claude. The only route in from the internet is POST /webhooks/github,
# which nginx exposes with an exact-match location and the app rejects unless the
# X-Hub-Signature-256 HMAC verifies. See docs/runbooks/software-factory.md.

# Optional local-development bridge. Production uses the GitHub App below.
GITHUB_TOKEN=your-github-token

# Shared secret configured on the GitHub App/webhook. Changing it means restarting
# software-factory, which reads it at boot, or every delivery fails with 401.
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# GitHub recommends the App client ID as the issuer for its short-lived JWT.
GITHUB_APP_CLIENT_ID=your-github-app-client-id
# Absolute HOST path to the PEM. Compose bind-mounts this file read-only into the
# container at /run/secrets/github-app.pem and overrides the in-container value of
# this variable to that path, so only the *path* ever appears here — never the key.
GITHUB_APP_PRIVATE_KEY_PATH=/opt/software-factory/github-app-private-key.pem

# Protects the internal POST /api/reviews manual trigger and GET /api/reviews/{id}.
# Neither is routed by nginx; both require this token regardless.
FACTORY_TRIGGER_TOKEN=your-factory-trigger-token

# Software factory image. :latest tracks main; pin a commit-SHA tag to roll back or
# hold a known build.
FACTORY_IMAGE=ghcr.io/simonjamesrowe/simonrowe-dev-monorepo-software-factory:latest

# Where the container clones pull-request branches. Backed by a named volume so the
# clones never touch the host filesystem.
FACTORY_WORKSPACE_ROOT=/workspace

# Deprecated aliases, accepted for one release so an un-migrated .env still boots.
# Delete once the containerised software-factory service is verified in production.
# REVIEWER_TRIGGER_TOKEN=
# REVIEWER_IMAGE=
# REVIEWER_WORKSPACE_ROOT=

# --- Claude credentials for the software factory ---
# Read only by the software-factory container, which declares no `env_file` and so
# sees only the variables listed explicitly in its compose `environment:` block.
#
# Authenticate with EITHER a subscription token OR an API key, never both. Setting both is
# a silent trap: ANTHROPIC_API_KEY takes precedence and is billed per token even though a
# subscription token is present.
#
# Subscription (Claude Pro/Max): run `claude setup-token` as a human and paste the result.
# Reviews then draw on the same usage limits as your interactive Claude Code sessions, so a
# burst of pull requests can exhaust the limit your own session depends on.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
# Pay-as-you-go alternative; leave unset when CLAUDE_CODE_OAUTH_TOKEN is set.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Path to the Claude binary inside the container image, which installs it here.
CLAUDE_COMMAND=/usr/local/bin/claude
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium
CLAUDE_MAX_TURNS=12
CLAUDE_TIMEOUT=15m

# Dedicated Auth0 Regular Web Application for temporal.simonrowe.dev. Do not
# reuse the public site's client, which may allow visitor sign-up.
TEMPORAL_AUTH0_CLIENT_ID=your-temporal-auth0-client-id
TEMPORAL_AUTH0_CLIENT_SECRET=your-temporal-auth0-client-secret
TEMPORAL_AUTH0_ISSUER=https://your-tenant.auth0.com/
# Dedicated Postgres role password for the temporal and temporal_visibility databases.
TEMPORAL_DB_PASSWORD=your-temporal-database-password

# Google Drive API (backup/restore)
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Google Cloud Text-to-Speech Long Audio (on-demand blog narration)
# Keep disabled until docs/setup/google-cloud-tts.md is complete. The credentials
# value is a HOST path to a dedicated service-account JSON file; Compose mounts it
# read-only at /run/secrets/google-cloud-tts.json and sets ADC inside the container.
NARRATION_ENABLED=false
# Leave empty while disabled so Compose uses its harmless /dev/null fallback.
GOOGLE_CLOUD_TTS_CREDENTIALS_PATH=
GOOGLE_CLOUD_TTS_PROJECT_ID=your-google-cloud-project-id
# Long Audio v1beta1 uses the numeric project number in its resource path.
GOOGLE_CLOUD_TTS_PROJECT_NUMBER=123456789012
# Bucket name only, without gs://. The bucket must be private and have a 1-day lifecycle.
GOOGLE_CLOUD_TTS_OUTPUT_BUCKET=your-project-id-simonrowe-tts-temp
GOOGLE_CLOUD_TTS_LOCATION=global
GOOGLE_CLOUD_TTS_LANGUAGE_CODE=en-GB
GOOGLE_CLOUD_TTS_VOICE_NAME=en-GB-Chirp3-HD-Charon
# These application limits are checked before a chargeable provider request.
NARRATION_MAX_BLOG_CHARACTERS=50000
NARRATION_MONTHLY_CHARACTER_LIMIT=1000000
NARRATION_POLL_INTERVAL=5s
NARRATION_OPERATION_TIMEOUT=5m
NARRATION_LEASE_DURATION=2m
NARRATION_RECOVERY_DELAY=30s
NARRATION_RATE_LIMIT_REQUESTS_PER_MINUTE=10

# --- Frontend Build Args (baked into image at build time) ---

# Google reCAPTCHA v2 site key (client-side widget)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Google Analytics measurement ID
VITE_GA_MEASUREMENT_ID=your-ga-measurement-id

# API base URL for frontend
VITE_API_BASE_URL=https://api.simonrowe.dev

# --- Pinggy Tunnel ---

# Pinggy Pro authentication token
PINGGY_TOKEN=your-pinggy-token

# --- Grafana Cloud (Observability) ---

# Grafana Cloud API key (shared for Loki and Tempo auth)
GRAFANA_CLOUD_API_KEY=your-grafana-cloud-api-key

# Tempo (distributed tracing)
GRAFANA_CLOUD_TEMPO_USER=your-tempo-user-id
GRAFANA_CLOUD_TEMPO_ENDPOINT=https://tempo-prod-25-prod-gb-south-1.grafana.net/otlp

# Loki (log aggregation)
GRAFANA_CLOUD_LOKI_USER=your-loki-user-id
GRAFANA_CLOUD_LOKI_ENDPOINT=https://logs-prod-035.grafana.net/loki/api/v1/push

# ------------------------------------------------------------------------------
# Langfuse & Auth0 Configuration
# ------------------------------------------------------------------------------
# Required for Langfuse Single Sign-On
AUTH_AUTH0_CLIENT_ID=your_auth0_client_id
AUTH_AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH_AUTH0_ISSUER=https://your-tenant.auth0.com

# Langfuse Security Configuration
# NEXTAUTH_URL = public URL of the Langfuse app (local dev: http://localhost:3000)
NEXTAUTH_URL=https://langfuse.simonrowe.dev
# Generate secrets with: openssl rand -base64 32  (ENCRYPTION_KEY: openssl rand -hex 32)
NEXTAUTH_SECRET=your_nextauth_secret
SALT=your_salt
ENCRYPTION_KEY=your_encryption_key

# Langfuse OTLP API Keys — these are the project keys Alloy uses to authenticate to the
# Langfuse OTLP ingest endpoint. With the LANGFUSE_INIT_* bootstrap below, the project is
# provisioned on startup with THESE SAME keys, so exporter and project agree by construction.
# (Pick any pk-lf-*/sk-lf-* values; they just have to match the INIT keys.)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# Langfuse deterministic bootstrap (idempotent — only creates resources that don't exist).
# Provisions the org, project, admin membership, and the fixed project keys on startup so
# a fresh/redeployed stack shows a project without any manual UI steps. The project keys
# MUST equal LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY above (compose wires them to those).
# LANGFUSE_INIT_USER_PASSWORD must be set for the admin user + org membership to be created;
# Auth0 SSO then links to that user by email so admin@simonrowe.dev sees the project on login.
LANGFUSE_INIT_ORG_ID=simonrowe
LANGFUSE_INIT_ORG_NAME=Simon Rowe
LANGFUSE_INIT_PROJECT_ID=simonrowe-dev
LANGFUSE_INIT_PROJECT_NAME=simonrowe.dev
LANGFUSE_INIT_USER_EMAIL=admin@simonrowe.dev
LANGFUSE_INIT_USER_NAME=Simon Rowe
LANGFUSE_INIT_USER_PASSWORD=your_langfuse_admin_password

# Langfuse Database
LANGFUSE_DB_USER=postgres
LANGFUSE_DB_PASSWORD=your_langfuse_db_password
LANGFUSE_DB_NAME=langfuse

# Langfuse v3 dependencies (ClickHouse for traces, Redis for queues, MinIO for blob/event storage)
CLICKHOUSE_PASSWORD=your_clickhouse_password
REDIS_AUTH=your_redis_password
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

# --- Docker CLI paths for the backend self-redeploy bind-mounts ---
# Compose defaults (/usr/bin/docker, /usr/libexec/docker/cli-plugins) exist on Linux hosts.
# On macOS/OrbStack, override to existing paths, e.g.:
#   DOCKER_BINARY_PATH=/opt/homebrew/bin/docker
#   DOCKER_PLUGINS_PATH=/Users/<you>/.docker/cli-plugins
DOCKER_BINARY_PATH=/usr/bin/docker
DOCKER_PLUGINS_PATH=/usr/libexec/docker/cli-plugins

# --- Dependency-Track -------------------------------------------------------
# All four DEPENDENCYTRACK_* variables below are REQUIRED. docker-compose.prod.yml
# declares them with compose's required-variable syntax (${VAR:?message}), so if any of
# them is missing OR empty, every `docker compose -f docker-compose.prod.yml ...` command
# fails immediately with a named error - including unrelated ones such as restarting the
# backend. That is deliberate: an empty value used to produce a silently broken deployment.
# Password for the `dtrack` Postgres role created inside the langfuse-db cluster.
# REQUIRED - the stack will not start without it.
# Must NOT contain a single quote ('). The value is interpolated into the CREATE ROLE /
# ALTER ROLE statement as a single-quoted SQL literal, so a quote breaks the statement with
# a syntax error and dependencytrack-db-init exits non-zero. `openssl rand -base64 32` is
# safe; avoid hand-picked passwords containing quotes.
DEPENDENCYTRACK_DB_PASSWORD=
# Auth0 issuer. MUST include the trailing slash - Dependency-Track does strict
# string equality against the discovery document, and a mismatch silently
# disables the login button with no error.
DEPENDENCYTRACK_OIDC_ISSUER=https://your-tenant.auth0.com/
# Client ID of the "Dependency-Track" Auth0 Single Page Application.
# REQUIRED - the stack will not start without it. Create the application and copy the
# Client ID by following the Dependency-Track SSO section of docs/auth0-setup.md.
DEPENDENCYTRACK_OIDC_CLIENT_ID=
# Key encryption key (KEK) for the Dependency-Track database secret manager.
# Base64-encoded AES-256 key (32 bytes), generated ONCE with `openssl rand -base64 32`.
# Must NEVER change once the database holds data: DT encrypts stored secrets with
# this key, and losing/rotating it means Dependency-Track can no longer decrypt them.
DEPENDENCYTRACK_KEK=
