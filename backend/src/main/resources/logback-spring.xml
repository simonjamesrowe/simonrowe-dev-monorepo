<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      Single console appender for all environments. Output format is controlled by
      Spring Boot's structured logging support (`logging.structured.format.console`):
        - unset (local dev)  -> human-readable plain text
        - `ecs` (prod)       -> one-line JSON per event for Loki ingestion
      In prod this is enabled via LOGGING_STRUCTURED_FORMAT_CONSOLE in docker-compose.prod.yml.
    -->
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
