// Shared by production and the opt-in local pilot. Only this branch is sanitized.
// No logs/metrics, browser ingress, prompts, tool payloads or private identifiers.
declare "pipeline" {
  argument "enabled" { default = false }
  argument "api_key" { default = "" }
  argument "endpoint" { default = "https://api.honeycomb.io" }
  argument "environment" { default = "development" }
  argument "sample_percentage" { default = 10 }
  // Absolute Unix seconds: restarts cannot extend a capture window. Zero is off.
  argument "export_until" { default = 0 }

  export "input" { value = otelcol.processor.transform.spring_http.input }

  otelcol.processor.transform "spring_http" {
    error_mode = "propagate"
    trace_statements {
      context = "span"
      // Spring's server convention puts the route template in uri. Client uri
      // and http.url can contain private paths: never promote those fields.
      conditions = [`scope.name == "org.springframework.boot" and kind == SPAN_KIND_SERVER`]
      statements = [
        `set(attributes["http.route"], attributes["uri"]) where attributes["http.route"] == nil and attributes["uri"] != nil`,
        `set(attributes["http.request.method"], attributes["method"]) where attributes["http.request.method"] == nil and attributes["method"] != nil`,
        `set(attributes["http.response.status_code"], Int(attributes["status"])) where attributes["http.response.status_code"] == nil and IsMatch(attributes["status"], "^[1-5][0-9]{2}$")`,
      ]
    }
    // Normalize before filtering so Micrometer actuator spans are excluded too.
    output { traces = [otelcol.processor.filter.gate.input] }
  }

  otelcol.processor.filter "gate" {
    error_mode = "propagate"
    traces {
      span = [
        string.format("%t", !argument.enabled.value || argument.api_key.value == ""),
        // JSON-decoded env numbers are floats; %d only accepts integer values.
        string.format("UnixSeconds(Now()) >= %v", argument.export_until.value),
        `resource.attributes["service.name"] != "simonrowe-backend"`,
        // This Alloy version cannot clear link attributes; omit linked spans in the pilot.
        `Len(links) > 0`,
        `IsMatch(attributes["http.route"], "^/actuator(/|$)")`,
      ]
      // Span events can include exception messages/prompts and cost extra events.
      spanevent = ["true"]
    }
    output { traces = [otelcol.processor.probabilistic_sampler.traces.input] }
  }

  otelcol.processor.probabilistic_sampler "traces" {
    sampling_percentage = argument.sample_percentage.value
    hash_seed = 1979
    output { traces = [otelcol.processor.transform.sanitize.input] }
  }

  otelcol.processor.transform "sanitize" {
    // Fail closed: a malformed value must never bypass content removal.
    error_mode = "propagate"
    trace_statements {
      context = "resource"
      statements = [
        `keep_keys(attributes, ["service.name", "service.version"])`,
        string.format("set(attributes[\"deployment.environment.name\"], %q)", argument.environment.value),
        `truncate_all(attributes, 128)`,
      ]
    }
    trace_statements {
      context = "scope"
      statements = [`keep_keys(attributes, [])`]
    }
    trace_statements {
      context = "span"
      statements = [
        // Normalize only known metadata fields; raw statements and message payloads stay excluded.
        `set(attributes["db.collection.name"], attributes["db.mongodb.collection"]) where attributes["db.collection.name"] == nil`,
        `set(attributes["messaging.destination.name"], attributes["messaging.destination"]) where attributes["messaging.destination.name"] == nil`,
        `set(attributes["messaging.operation.name"], attributes["messaging.operation"]) where attributes["messaging.operation.name"] == nil`,
        `keep_keys(attributes, ["http.request.method", "http.method", "http.route", "http.response.status_code", "http.status_code", "error.type", "db.system", "db.system.name", "db.operation", "db.operation.name", "gen_ai.operation.name", "gen_ai.system", "gen_ai.provider.name", "gen_ai.request.model", "gen_ai.response.model", "gen_ai.usage.input_tokens", "gen_ai.usage.output_tokens", "gen_ai.usage.prompt_tokens", "gen_ai.usage.completion_tokens", "spring.ai.kind", "db.collection.name", "app.repository.method", "app.query.name", "app.operation", "app.outcome", "messaging.system", "messaging.destination.name", "messaging.operation.name"])`,
        `truncate_all(attributes, 256)`,
        // Only reviewed static namespaces and outcomes can become labels or names.
        `delete_key(attributes, "db.collection.name") where attributes["db.collection.name"] != "blogs" and attributes["db.collection.name"] != "tags" and attributes["db.collection.name"] != "skills" and attributes["db.collection.name"] != "media_assets" and attributes["db.collection.name"] != "short_links" and attributes["db.collection.name"] != "article_summaries" and attributes["db.collection.name"] != "narrations"`,
        `delete_key(attributes, "messaging.destination.name") where attributes["messaging.destination.name"] != "content-changes" and attributes["messaging.destination.name"] != "summary-requests" and attributes["messaging.destination.name"] != "narration-requests"`,
        `delete_key(attributes, "messaging.system") where attributes["messaging.system"] != "kafka"`,
        `delete_key(attributes, "messaging.operation.name") where attributes["messaging.operation.name"] != "publish" and attributes["messaging.operation.name"] != "send" and attributes["messaging.operation.name"] != "process" and attributes["messaging.operation.name"] != "receive"`,
        `delete_key(attributes, "app.operation") where attributes["app.operation"] != "summary.generate" and attributes["app.operation"] != "narration.generate"`,
        `delete_key(attributes, "app.outcome") where attributes["app.outcome"] != "success" and attributes["app.outcome"] != "failed" and attributes["app.outcome"] != "skipped" and attributes["app.outcome"] != "unavailable" and attributes["app.outcome"] != "queued" and attributes["app.outcome"] != "stale" and attributes["app.outcome"] != "rejected" and attributes["app.outcome"] != "uncertain"`,
        // Repository/query IDs are constructed from code identifiers, never arguments.
        `delete_key(attributes, "app.repository.method") where attributes["app.repository.method"] != nil and not IsMatch(attributes["app.repository.method"], "^(BlogRepository|AdminBlogRepository|MediaAssetRepository|ShortLinkRepository)[.](find|count|exists)[A-Za-z0-9]{0,160}$")`,
        `delete_key(attributes, "app.query.name") where attributes["app.query.name"] != nil and not IsMatch(attributes["app.query.name"], "^(blogs|media_assets|short_links)[.](find|count|exists)[A-Za-z0-9]{0,160}$")`,
        // Span names/status/links are content carriers too, not just attributes.
        `set(name, "operation")`,
        `set(name, attributes["db.operation"]) where attributes["db.operation"] != nil`,
        `set(name, attributes["db.operation.name"]) where attributes["db.operation.name"] != nil`,
        `set(name, attributes["gen_ai.operation.name"]) where attributes["gen_ai.operation.name"] != nil`,
        `set(name, Concat([name, attributes["db.collection.name"]], " ")) where attributes["db.collection.name"] != nil and (attributes["db.operation"] != nil or attributes["db.operation.name"] != nil)`,
        `set(name, Concat([attributes["messaging.destination.name"], attributes["messaging.operation.name"]], " ")) where attributes["messaging.system"] == "kafka" and attributes["messaging.destination.name"] != nil and attributes["messaging.operation.name"] != nil`,
        `set(name, attributes["app.repository.method"]) where attributes["app.repository.method"] != nil`,
        `set(name, attributes["app.operation"]) where attributes["app.operation"] != nil`,
        `set(name, attributes["http.route"]) where attributes["http.route"] != nil`,
        `set(status.message, "")`,
        `set(trace_state, "")`,
        // This is an independent fixed probability after any SDK sampling.
        // Do not claim totals are corrected for upstream drops.
        // Calculate per span: 0% drops everything without dividing by zero while
        // Alloy builds the shared graph (including Langfuse and Loki).
        string.format("set(attributes[\"SampleRate\"], 100.0 / %v) where %v > 0", argument.sample_percentage.value, argument.sample_percentage.value),
        `set(attributes["app.module"], "site") where attributes["http.route"] != nil`,
        `set(attributes["app.module"], "coparent") where IsMatch(attributes["http.route"], "^/api/coparent(/|$)")`,
        `set(attributes["app.module"], "school") where IsMatch(attributes["http.route"], "^/api/school(/|$)")`,
        `set(attributes["app.module"], "meals") where IsMatch(attributes["http.route"], "^/api/meals(/|$)")`,
        `set(attributes["app.module"], "admin") where IsMatch(attributes["http.route"], "^/api/admin(/|$)")`,
      ]
    }
    output { traces = [otelcol.processor.batch.honeycomb.input] }
  }

  otelcol.processor.batch "honeycomb" {
    timeout = "1s"
    send_batch_size = 128
    send_batch_max_size = 128
    output { traces = [otelcol.exporter.otlphttp.honeycomb.input] }
  }

  otelcol.exporter.otlphttp "honeycomb" {
    // Honeycomb supports OTLP/HTTP JSON; integration tests inspect this exact wire format.
    encoding = "json"
    client {
      endpoint = argument.endpoint.value
      headers = { "x-honeycomb-team" = argument.api_key.value }
      timeout = "5s"
    }
    sending_queue {
      enabled = true
      num_consumers = 2
      queue_size = 64
    }
    retry_on_failure {
      enabled = true
      max_elapsed_time = "30s"
    }
  }
}
