// =============================================================================
// Grafana Alloy Configuration
// Receives OTLP traces from the backend and (when enabled) forwards to Grafana
// Cloud Tempo / Langfuse. Collects Docker container logs and sends to Grafana
// Cloud Loki.
// =============================================================================

// ---------------------
// OTLP Trace Receiver
// ---------------------
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

// ---------------------
// Batch Processor
// ---------------------
otelcol.processor.batch "default" {
	output {
		// Trace exporters disabled 2026-07-11 (both returned HTTP 404):
		//  - Tempo:    GRAFANA_CLOUD_TEMPO_ENDPOINT points at gb-south-1, but this
		//              account's Tempo instance + token are US region (Loki push on the
		//              US cluster works with the same key). Set the correct US OTLP
		//              endpoint (Grafana Cloud > Connections > OTLP) and re-enable below.
		//  - Langfuse: v2.95.1 has no OTLP ingest endpoint (/api/public/otel is v3+).
		//              Re-enable after upgrading Langfuse to v3.
		// To re-enable, restore the exporter blocks below and list their inputs here, e.g.
		//   traces = [otelcol.exporter.otlphttp.tempo.input]
		traces = []
	}
}

