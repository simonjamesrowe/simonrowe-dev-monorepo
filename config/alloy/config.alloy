// =============================================================================
// Grafana Alloy Configuration
// Receives OTLP traces from the backend and (when enabled) forwards to Grafana
// Cloud Tempo / Langfuse. Collects Docker container logs and sends to Grafana
// Cloud Loki.
// =============================================================================

// ---------------------
// OTLP Trace Receiver
// ---------------------
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

// ---------------------
// Batch Processor
// ---------------------
otelcol.processor.batch "default" {
	output {
		// Tempo exporter disabled 2026-07-11 (HTTP 404): GRAFANA_CLOUD_TEMPO_ENDPOINT
		// points at gb-south-1, but this account's Tempo instance + token are US region
		// (Loki push on the US cluster works with the same key). Set the correct US OTLP
		// endpoint (Grafana Cloud > Connections > OTLP), restore the exporter block below,
		// and add otelcol.exporter.otlphttp.tempo.input back to this list.
		//
		// Langfuse exporter re-enabled 2026-07-12 after upgrading to Langfuse v3, which
		// added the /api/public/otel OTLP ingest endpoint. Langfuse is fed through the
		// ai_only filter so it receives ONLY Spring AI gen_ai spans (chat generations,
		// embeddings, tool calls) — not the HTTP-server / MongoDB / @WithSpan noise.
		traces = [otelcol.processor.filter.ai_only.input]
	}
}

// ---------------------
// AI-only Filter (Langfuse)
// ---------------------
// Keep ONLY Spring AI spans for Langfuse. Every Spring AI model observation carries the
// OpenTelemetry GenAI attributes gen_ai.operation.name + gen_ai.system (from Spring AI's
// AiObservationAttributes), and tool-call observations carry spring.ai.kind. Any span with
// none of these is HTTP/Mongo/manual-@WithSpan noise, so it is dropped. filter.traces.span
// lists DROP conditions (a span is dropped when its OTTL expression is true).
otelcol.processor.filter "ai_only" {
	error_mode = "ignore"

	traces {
		span = [
			"attributes[\"gen_ai.operation.name\"] == nil and attributes[\"gen_ai.system\"] == nil and attributes[\"spring.ai.kind\"] == nil",
		]
	}

	output {
		traces = [otelcol.exporter.otlphttp.langfuse.input]
	}
}

/*
// ---------------------
// Grafana Cloud Auth  (DISABLED — see note in batch processor above)
// ---------------------
otelcol.auth.basic "grafana_cloud" {
	username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
	password = sys.env("GRAFANA_CLOUD_API_KEY")
}

// ---------------------
// Tempo Trace Exporter  (DISABLED — wrong-region endpoint, 404)
// ---------------------
otelcol.exporter.otlphttp "tempo" {
	client {
		endpoint = sys.env("GRAFANA_CLOUD_TEMPO_ENDPOINT")
		auth     = otelcol.auth.basic.grafana_cloud.handler
	}
}
*/

// ---------------------
// Docker Log Discovery
// ---------------------
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_image"]
		target_label  = "image"
	}

	// Expose the compose service name (stable across host/project-name changes)
	// as a label, then use it to drop high-volume containers below.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	// Skip shipping logs for these containers entirely — they generate too much
	// volume for the Grafana Cloud free tier. Add service names to the regex to
	// exclude more (they stay visible via Portainer / `docker logs`).
	rule {
		source_labels = ["service"]
		regex         = "kafka|mongodb|frontend|langfuse-db"
		action        = "drop"
	}
}

// ---------------------
// Docker Log Collection
// ---------------------
loki.source.docker "default" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.docker_logs.rules
	forward_to    = [loki.write.grafana_cloud.receiver]
}

// ---------------------
// Loki Log Exporter
// ---------------------
loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_ENDPOINT")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_API_KEY")
		}
	}
}

// ---------------------
// Langfuse Trace Exporter
// ---------------------
otelcol.auth.basic "langfuse" {
	username = sys.env("LANGFUSE_PUBLIC_KEY")
	password = sys.env("LANGFUSE_SECRET_KEY")
}

otelcol.exporter.otlphttp "langfuse" {
	client {
		endpoint = "http://langfuse:3000/api/public/otel"
		auth     = otelcol.auth.basic.langfuse.handler
	}
}
