# Copy to /opt/temporal-reviewer/reviewer.env with mode 0640, owned by
# root:temporal-reviewer. Replace every placeholder without committing values.

GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_PRIVATE_KEY_PATH=/opt/temporal-reviewer/github-app-private-key.pem

# Authenticate Claude with EITHER a subscription token OR an API key, not both:
# an API key takes precedence and will be billed per token.
#
# Subscription (Claude Pro/Max): run `claude setup-token` as a human, then paste
# the value here. Reviews then draw on your subscription usage limits, which are
# shared with your own interactive Claude Code use.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
# Pay-as-you-go alternative; leave unset when CLAUDE_CODE_OAUTH_TOKEN is set.
# ANTHROPIC_API_KEY=your-anthropic-api-key

CLAUDE_COMMAND=/usr/local/bin/claude
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium
CLAUDE_MAX_TURNS=12
CLAUDE_TIMEOUT=15m
