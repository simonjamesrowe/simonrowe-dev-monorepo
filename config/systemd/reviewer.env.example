# Copy to /opt/temporal-reviewer/reviewer.env with mode 0640, owned by
# root:temporal-reviewer. Replace every placeholder without committing values.

GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_PRIVATE_KEY_PATH=/opt/temporal-reviewer/github-app-private-key.pem
ANTHROPIC_API_KEY=your-anthropic-api-key

CLAUDE_COMMAND=/usr/local/bin/claude
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium
CLAUDE_MAX_TURNS=12
CLAUDE_TIMEOUT=15m
