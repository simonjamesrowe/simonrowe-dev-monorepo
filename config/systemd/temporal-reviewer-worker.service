[Unit]
Description=Temporal code-review worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=temporal-reviewer
Group=temporal-reviewer
Environment=HOME=/var/lib/temporal-reviewer
Environment=SPRING_PROFILES_ACTIVE=worker
Environment=TEMPORAL_ADDRESS=127.0.0.1:7233
Environment=REVIEWER_WORKSPACE_ROOT=/var/lib/temporal-reviewer/workspaces
EnvironmentFile=/opt/temporal-reviewer/reviewer.env
WorkingDirectory=/var/lib/temporal-reviewer
ExecStart=/usr/bin/java -jar /opt/temporal-reviewer/reviewer.jar
Restart=always
RestartSec=10
TimeoutStopSec=45

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/temporal-reviewer
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
